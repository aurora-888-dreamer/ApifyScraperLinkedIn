{
    "title": "LinkedIn Public Jobs Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keyword": {
            "title": "Keyword Posisi Pekerjaan",
            "type": "string",
            "description": "Contoh: Data Scientist, React Developer, Admin",
            "default": "Python Developer"
        },
        "location": {
            "title": "Lokasi Negara/Kota",
            "type": "string",
            "description": "Contoh: Indonesia, Jakarta, Singapore",
            "default": "Indonesia"
        },
        "max_pages": {
            "title": "Jumlah Halaman yang Di-scrap",
            "type": "integer",
            "description": "1 halaman berisi sekitar 25 lowongan kerja.",
            "default": 3,
            "minimum": 1
        }
    },
    "required": ["keyword", "location"]
}